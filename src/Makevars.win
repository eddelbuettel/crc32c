
CMAKE = cmake

export CC = $(CC)
export CFLAGS = $(CFLAGS) $(CPICFLAGS)
export CXX = $(CXX)
export CXXFLAGS = $(CXXFLAGS) $(CXXPICFLAGS) $(C_VISIBILITY)
export AR = $(AR)
export RANLIB = $(RANLIB)

XTRA_LIB = crc32c/libcrc32c.a

PKG_LIBS = $(XTRA_LIB)

PKG_CPPFLAGS = -Icrc32c/include

.Phony: all

all: $(XTRA_LIB) $(SHLIB)

$(SHLIB): $(XTRA_LIB)

$(XTRA_LIB):
	mkdir crc32c/build && \
		cd crc32c/build && \
		${CMAKE} .. && \
		${MAKE} all && \
		cp -v libcrc32c.a .. && \
		rm -rf *
